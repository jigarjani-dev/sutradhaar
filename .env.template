# LLM provider (OpenAI-compatible endpoint)
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your-deepseek-api-key-here

# Default model for agents
LLM_MODEL=deepseek-chat

# Google OAuth (set after running gws auth login)
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=/root/.config/gws/credentials.json

# Telegram bot token (set after creating bot with BotFather)
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Mock mode -- skips gws/Telegram and uses sample data
# MOCK_TOOLS=true
